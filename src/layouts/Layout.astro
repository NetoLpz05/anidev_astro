---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Catálogo de Mangas AniDev" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>

  <body
    class="margin-0 p-0 bg-zinc-950 min-h-screen w-full selection:bg-purple-500 selection:text-white"
  >
    <slot />
  </body>
</html>

<style is:global>
  /* 🌟 Forzamos a que ni el html ni el body tengan cajas restrictivas */
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100vh;
    background-color: #09090b; /* Equivale a bg-zinc-950 por si tarda en cargar Tailwind */
  }
</style>
