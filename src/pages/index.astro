---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const books = await getCollection("books");
---

<Layout title="AniDev: Mangas (y ya jeje)">
  <main>
    <h1 class="text-center text-7xl font-extrabold mb-24 text-white">AniDev</h1>
  </main>

  <section aria-label="Mejores mangas del fokin worl">
    <div class="px-4 mx-auto max-w-7xl">
      <div class="grid gap-6 grid-cols-1 md:grid-cols-2">
        {
          books.map((book) => {
            const { slug, data } = book;
            const { title, author, img, readtime, description, buy } = data;
            const cleanId = slug.replace(/\.md$/, "");

            return (
              <article class="flex">
                <a
                  href={`/libro/${cleanId}`}
                  class="mb-2 xl:mb-0 transition hover:scale-105 flex-shrink-0"
                >
                  <img
                    transition:name={`img-${slug}`}
                    class="w-32 md:w-44 rounded-lg object-cover"
                    src={`/${img}`}
                    alt={title}
                  />
                </a>

                <div class="flex flex-col justify-center ml-5">
                  <h2 class="mb-2 text-2xl font-bold leading-tight text-white">
                    {title}
                  </h2>
                  <p class="text-gray-400 text-sm mb-2">Por {author}</p>
                  <p class="mb-4 text-gray-300 max-w-sm text-sm line-clamp-3">
                    {description}
                  </p>
                  <span class="text-xs text-purple-400 font-semibold">
                    Lectura en {readtime} horas
                  </span>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</Layout>
